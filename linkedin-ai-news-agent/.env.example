# Text LLM (any OpenAI-compatible API: Gemini, Groq, NVIDIA NIM, OpenRouter...)
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.0-flash

# Image generation: free providers are tried in this order
IMAGE_PROVIDERS=cloudflare,pollinations,huggingface
# Cloudflare Workers AI (free ~230 FLUX images/day): dash.cloudflare.com > AI > Workers AI
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Hugging Face (small free credit)
HF_TOKEN=
IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# LinkedIn (needs Community Management API approval)
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORG_ID=
